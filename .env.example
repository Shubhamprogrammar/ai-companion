# Copy to .env and fill in values. Never commit .env.

# --- Application ---
# development | test | production
APP_ENV=development
APP_NAME=Personal AI Companion
LOG_LEVEL=INFO
LOG_JSON=true
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# JSON list, e.g. ["http://localhost:3000"]
CORS_ORIGINS=[]

# --- Database (host-side; inside docker compose the app uses the `db` service) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=companion
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/companion
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/companion_test
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# --- Redis (compose maps container 6379 -> host REDIS_PORT; 6380 avoids clashing with a host Redis) ---
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0

# --- OpenAI ---
# Model names are deliberately blank; set them to models your account can use
# (list them with: python scripts/list_openai_models.py).
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_STT_MODEL=
OPENAI_TTS_MODEL=
OPENAI_EMBEDDING_MODEL=
OPENAI_TTS_VOICE=
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
OPENAI_MAX_OUTPUT_TOKENS=2048
# Optional; only sent when set (model-dependent, e.g. low | medium | high)
OPENAI_REASONING_EFFORT=
# Keep false: conversation state lives in our DB, not on OpenAI's side
OPENAI_STORE_RESPONSES=false

# Optional cheaper model for background memory extraction/summaries (defaults to chat model)
OPENAI_MEMORY_MODEL=

# --- Memory (long-term, pgvector) ---
MEMORY_RECALL_LIMIT=5
MEMORY_CORE_LIMIT=5
# Calibrated for text-embedding-3-small (relevant ≈0.56–0.74, unrelated ≥0.80)
MEMORY_MAX_DISTANCE=0.78
MEMORY_DEDUP_DISTANCE=0.15
MEMORY_MAX_PER_USER=500
SUMMARY_TRIGGER_MESSAGES=10

# --- Tools ---
TOOLS_ENABLED=true
# JSON list of tool names to switch off, e.g. ["search_web"]
TOOLS_DISABLED=[]
TOOL_MAX_ROUNDS=3
TOOL_MAX_CALLS_PER_TURN=5
CONFIRMATION_TTL_MINUTES=10
# none | openai  (openai = OpenAI's built-in web_search tool, billed per search)
WEB_SEARCH_PROVIDER=none
OPENAI_WEB_SEARCH_MODEL=

# --- WebSocket voice sessions ---
WS_AUTH_TIMEOUT_SECONDS=10
WS_IDLE_TIMEOUT_SECONDS=120
WS_MAX_SESSION_MINUTES=30
WS_MAX_SESSIONS_PER_USER=3
WS_MAX_FRAME_BYTES=524288

# --- Voice ---
# JSON list of ISO-639-1 hints for speech-to-text (supported by gpt-transcribe); [] to disable
OPENAI_STT_LANGUAGES=["en","hi"]
# Where retained audio is written when AUDIO_RETENTION_ENABLED=true
AUDIO_STORAGE_PATH=audio_storage

# --- Companion ---
COMPANION_NAME=Mira
CHAT_CONTEXT_MAX_MESSAGES=30
CHAT_CONTEXT_MAX_CHARS=24000
CHAT_RATE_LIMIT_PER_MINUTE=20

# --- Auth ---
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Memory / audio ---
MEMORY_ENABLED=true
AUDIO_RETENTION_ENABLED=false
# Max upload size (OpenAI's limit is 25)
MAX_AUDIO_SIZE_MB=20

# --- Rate limiting ---
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=10
